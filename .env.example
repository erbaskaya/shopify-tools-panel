# Tek mağaza kullanımı (geriye uyumlu)
SHOP_NAME=Ana Magaza
SHOP_DOMAIN=example.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxx
API_VERSION=2026-04

# Birden fazla mağaza kullanacaksan yukarıdaki SHOP_DOMAIN/TOKEN yerine bunu kullanabilirsin.
# Tek satır JSON olarak Environment Variable'a ekle.
# SHOPIFY_STORES_JSON=[{"key":"hausone","name":"HAUSONE","domain":"xxxx.myshopify.com","token":"shpat_xxx","api_version":"2026-04"},{"key":"store2","name":"Store 2","domain":"yyyy.myshopify.com","token":"shpat_yyy","api_version":"2026-04"}]

PANEL_PASSWORD=buraya_panel_sifresi
SECRET_KEY=buraya_rastgele_uzun_bir_metin
COOKIE_SECURE=true

# Vercel üzerinde panelden mağaza ekleme/düzenleme için kalıcı PostgreSQL bağlantısı.
# Vercel/Neon entegrasyonu bu değeri otomatik oluşturabilir.
# DATABASE_URL=postgresql://...
